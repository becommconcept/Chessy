# Base de données (SQLite par défaut — passer à PostgreSQL en production)
DATABASE_URL="file:./dev.db"

# Clé de signature des sessions du back-office (32 caractères minimum)
AUTH_SECRET="changez-cette-cle-secrete-en-production-32c"

# URL publique du site (sitemap, flux RSS, courriels)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Envoi des courriels de notification (optionnel : sans configuration, les
# messages sont journalisés dans la console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Mairie de Chessy-les-Mines <ne-pas-repondre@chessy69.fr>"
MAIRIE_NOTIFY_EMAIL="accueil@chessy69.fr"
